# google-workspace-mcp environment.
#
# This file is generated/managed by install.sh — you should not need to edit
# it by hand. All APPLICATION state (OAuth credentials, account refresh tokens,
# audit log) lives in the SQLite database, not here.
#
# TWO values in here are as precious as the database and must SURVIVE UPGRADES:
#   - APP_KEY      : decrypts the stored OAuth client + refresh tokens. If it is
#                    lost or regenerated, every stored secret becomes
#                    unrecoverable and all accounts must be re-added.
#   - DB_DATABASE  : absolute path to data.sqlite (see below).
# Never run `php artisan key:generate` again after the first install.

APP_NAME=google-workspace-mcp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logs go to a file, NEVER to stdout — stdout is the MCP JSON-RPC channel.
LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# All persistent state. install.sh sets DB_DATABASE to the absolute path
# ~/.google-workspace-mcp/data.sqlite so it is independent of the cwd.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/.google-workspace-mcp/data.sqlite

# Database-backed cache hands off OAuth-flow state between the stdio server and
# the detached callback listener (two separate processes).
CACHE_STORE=database

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
